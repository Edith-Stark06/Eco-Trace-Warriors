# Device Intelligence Engine — example environment configuration
#
# Copy to `.env` and adjust as needed. Never commit a real `.env`
# (see repository .gitignore). All variables are optional; sensible
# defaults are applied by device_ai/configs/settings.py.

# --- Service identity ---
APP_NAME="EcoTrace Device Intelligence Engine"
ENVIRONMENT=development            # development | staging | production

# --- Networking ---
HOST=0.0.0.0
PORT=8100

# --- Filesystem locations ---
MODEL_DIR=models                  # root of versioned model artifacts
UPLOAD_DIR=uploads                # optional transient upload storage
DATASET_DIR=datasets              # root of managed dataset sub-folders
ARTIFACT_DIR=artifacts            # root of training checkpoints/exports/reports + registry
MLRUNS_DIR=mlruns                 # root of experiment-tracking run records

# --- Upload constraints ---
MAX_IMAGES=6
MIN_IMAGES=1
MAX_FILE_SIZE=10485760            # 10 MB, in bytes
MIN_IMAGE_DIMENSION=32
MAX_IMAGE_DIMENSION=12000

# --- Dataset pipeline (M1.2) ---
DUPLICATE_HAMMING_THRESHOLD=5     # max perceptual-hash distance for a duplicate
BLUR_THRESHOLD=100.0              # variance-of-Laplacian below = blurry
BRIGHTNESS_DARK_THRESHOLD=40.0    # mean luminance below = too dark
BRIGHTNESS_BRIGHT_THRESHOLD=220.0 # mean luminance above = too bright
SPLIT_SEED=42                     # deterministic split seed

# --- Training & MLOps platform (M1.3) ---
EXPERIMENT_TRACKER=json           # json | mlflow | none
TRAINING_SEED=42                  # default RNG seed for reproducible runs

# --- Device detector (M1.4 / P5.0) ---
DETECTOR_WEIGHTS=yolov8n.pt        # file/dir under MODEL_DIR; falls back to mock if absent
DETECTOR_IMAGE_SIZE=640            # inference image size (px)
DETECTOR_CONFIDENCE_THRESHOLD=0.25 # minimum kept-detection confidence

# --- P5.0 Final ML Inference Engine ---
INFERENCE_MODE=single_model        # single_model | ensemble
ENSEMBLE_MODEL_A_WEIGHTS=dataset_acquisition/training/p4_11_multisource_targeted_aug_v1/runs/p411_yolo11n_targeted_aug/weights/best.pt
ENSEMBLE_MODEL_B_WEIGHTS=dataset_acquisition/training/p4_12_model_scale_v1/runs/p412_yolo11s/weights/best.pt
ENSEMBLE_WEIGHTS_A=0.5             # Model A (P4.11) fusion weight
ENSEMBLE_WEIGHTS_B=0.5             # Model B (P4.12) fusion weight
ENSEMBLE_USE_TTA=true              # Enable Test-Time Augmentation
ENSEMBLE_IOU_THRESHOLD=0.55        # IoU clustering threshold for WBF
ENSEMBLE_IMAGE_SIZE=512            # Inference resolution (px) for ensemble
# --- P5.2 Device Registration & Workflow ---
# --- P5.3 Device Intelligence Enrichment ---
MATERIAL_PROFILE_VERSION=v1.0.0    # version for material composition catalogue
CARBON_MODEL_VERSION=v1.0.0        # version for carbon scoring model
CARBON_CALCULATION_METHODOLOGY=avoided_burden_co2e

# --- P5.4 PostgreSQL Persistence ---
DEVICE_BACKEND=memory              # memory | json | postgres
DATABASE_URL=postgresql+psycopg://ecotrace:ecotrace123@localhost:5432/ecotrace
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# --- P5.8–P5.10 Trust Anchor & Verification ---
TRUST_ANCHOR_BACKEND=memory         # memory | postgres
TRUST_ANCHOR_MAX_AGE_DAYS=90        # max age in days before anchor is STALE (empty/0 disables)

# --- P5.11 External / Blockchain Trust Ledger ---
EXTERNAL_TRUST_BACKEND=memory       # memory | fabric | disabled
EXTERNAL_TRUST_ENABLED=true
EXTERNAL_TRUST_NETWORK=ecotrace-channel
EXTERNAL_TRUST_PROVIDER=hyperledger_fabric
EXTERNAL_TRUST_CHAINCODE=ecotrace-lifecycle
EXTERNAL_TRUST_CHANNEL=ecotrace-channel

# --- Observability ---
LOG_LEVEL=INFO                    # TRACE|DEBUG|INFO|SUCCESS|WARNING|ERROR|CRITICAL
JSON_LOGS=false                   # true for machine-readable JSON logs

# --- Model contract ---
MODEL_VERSION=1.0.0
