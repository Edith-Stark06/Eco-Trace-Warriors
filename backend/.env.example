# EcoTrace Backend — Environment Variables
# Copy to .env and fill in values. Never commit .env.

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Database (PostgreSQL) — used from Phase 3 onward
DATABASE_URL=postgresql://ecotrace:ecotrace@localhost:5432/ecotrace?schema=public

# Auth (JWT + bcrypt) — used from Phase 4 onward
# Secrets MUST be overridden with strong random values (>= 32 chars) in production;
# the dev-insecure-* placeholders are rejected when NODE_ENV=production.
JWT_SECRET=dev-insecure-access-secret-change-me-00000000
JWT_REFRESH_SECRET=dev-insecure-refresh-secret-change-me-0000000
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=10

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173
