generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  name        UserRole @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@map("roles")
}

model User {
  id                   String              @id @default(uuid())
  fullName             String
  email                String              @unique
  passwordHash         String
  phone                String?
  address              String?
  region               String?
  emailVerified        Boolean             @default(false)
  isActive             Boolean             @default(true)
  lastLogin            DateTime?
  roleId               String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  greenCoins           Int                 @default(0)
  refreshTokens        RefreshToken[]
  rewardTransactions   RewardTransaction[]
  collectedSubmissions Submission[]        @relation("SubmissionCollector")
  recycledSubmissions  Submission[]        @relation("SubmissionRecycler")
  submissions          Submission[]        @relation("SubmissionOwner")
  role                 Role                @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Submission {
  id                  String             @id @default(uuid())
  userId              String
  category            String
  description         String?
  estimatedWeight     Float
  address             String
  latitude            Float
  longitude           Float
  imageUrls           String[]           @default([])
  status              SubmissionStatus   @default(PENDING)
  assignedCollectorId String?
  assignedRecyclerId  String?
  pickupScheduledAt   DateTime?
  completedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  materialRecovery    Json?
  processingStartedAt DateTime?
  recoveredWeight     Float?
  recycledAt          DateTime?
  recyclerNotes       String?
  co2Saved            Float?
  energySaved         Float?
  landfillDiverted    Float?
  rewardIssued        Boolean            @default(false)
  rewardTransaction   RewardTransaction?
  assignedCollector   User?              @relation("SubmissionCollector", fields: [assignedCollectorId], references: [id])
  assignedRecycler    User?              @relation("SubmissionRecycler", fields: [assignedRecyclerId], references: [id])
  user                User               @relation("SubmissionOwner", fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([assignedCollectorId])
  @@index([assignedRecyclerId])
  @@map("submissions")
}

model RewardTransaction {
  id           String       @id @default(uuid())
  userId       String
  submissionId String       @unique
  points       Int
  reason       RewardReason
  createdAt    DateTime     @default(now())
  submission   Submission   @relation(fields: [submissionId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("reward_transactions")
}

enum UserRole {
  ADMIN
  GOVERNMENT
  RECYCLER
  COLLECTOR
  CONSUMER
}

enum SubmissionStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COLLECTED
  RECYCLING
  RECYCLED
  COMPLETED
  REJECTED
}

enum RewardReason {
  RECYCLING
  BONUS
  CAMPAIGN
  ADJUSTMENT
  REDEMPTION
}
