generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  name        UserRole @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@map("roles")
}

model User {
  id                   String              @id @default(uuid())
  fullName             String
  email                String              @unique
  passwordHash         String
  phone                String?
  address              String?
  region               String?
  emailVerified        Boolean             @default(false)
  isActive             Boolean             @default(true)
  lastLogin            DateTime?
  roleId               String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  greenCoins           Int                 @default(0)
  refreshTokens        RefreshToken[]
  rewardTransactions   RewardTransaction[]
  collectedSubmissions Submission[]        @relation("SubmissionCollector")
  recycledSubmissions  Submission[]        @relation("SubmissionRecycler")
  submissions          Submission[]        @relation("SubmissionOwner")
  notifications        Notification[]
  role                 Role                @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Submission {
  id                  String             @id @default(uuid())
  userId              String
  category            String
  description         String?
  estimatedWeight     Float
  address             String
  latitude            Float
  longitude           Float
  imageUrls           String[]           @default([])
  status              SubmissionStatus   @default(PENDING)
  assignedCollectorId String?
  assignedRecyclerId  String?
  pickupScheduledAt   DateTime?
  completedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  materialRecovery    Json?
  processingStartedAt DateTime?
  recoveredWeight     Float?
  recycledAt          DateTime?
  recyclerNotes       String?
  co2Saved            Float?
  energySaved         Float?
  landfillDiverted    Float?
  rewardIssued        Boolean            @default(false)
  // Cross-domain link to intelligence/device_ai's Device record (P10.1).
  // Nullable: historical submissions and submissions never paired with a
  // physical device registration have no device. Unique: one device maps to
  // at most one submission, and vice versa. Only the identifiers are stored
  // here — the Device model itself stays in device_ai's own database.
  deviceId            String?            @unique
  ecoId               String?            @unique
  rewardTransaction   RewardTransaction?
  notifications       Notification[]
  assignedCollector   User?              @relation("SubmissionCollector", fields: [assignedCollectorId], references: [id])
  assignedRecycler    User?              @relation("SubmissionRecycler", fields: [assignedRecyclerId], references: [id])
  user                User               @relation("SubmissionOwner", fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([assignedCollectorId])
  @@index([assignedRecyclerId])
  @@map("submissions")
}

model RewardTransaction {
  id           String       @id @default(uuid())
  userId       String
  submissionId String       @unique
  points       Int
  reason       RewardReason
  createdAt    DateTime     @default(now())
  submission   Submission   @relation(fields: [submissionId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("reward_transactions")
}

/**
 * In-app consumer notification (P10.3). Persisted, authenticated-API-only —
 * no push token, email, phone, or free-form fields: the message is always
 * generated server-side from a real lifecycle transition, never user input.
 * The (userId, submissionId, type) unique constraint makes notification
 * creation idempotent — at most one notification per submission per event
 * type, even if the triggering lifecycle call is ever repeated.
 */
model Notification {
  id           String           @id @default(uuid())
  userId       String
  submissionId String
  type         NotificationType
  message      String
  createdAt    DateTime         @default(now())
  readAt       DateTime?
  user         User             @relation(fields: [userId], references: [id])
  submission   Submission       @relation(fields: [submissionId], references: [id])

  @@unique([userId, submissionId, type])
  @@index([userId])
  @@index([createdAt])
  @@index([readAt])
  @@map("notifications")
}

enum UserRole {
  ADMIN
  GOVERNMENT
  RECYCLER
  COLLECTOR
  CONSUMER
}

enum SubmissionStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COLLECTED
  RECYCLING
  RECYCLED
  COMPLETED
  REJECTED
}

enum RewardReason {
  RECYCLING
  BONUS
  CAMPAIGN
  ADJUSTMENT
  REDEMPTION
}

/** Closed set of real submission-lifecycle events a consumer is notified about. */
enum NotificationType {
  COLLECTOR_ASSIGNED
  ITEM_COLLECTED
  RECYCLING_COMPLETED
}
