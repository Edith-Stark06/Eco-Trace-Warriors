generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GOVERNMENT
  RECYCLER
  COLLECTOR
  CONSUMER
}

enum SubmissionStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COLLECTED
  RECYCLED
  COMPLETED
  REJECTED
}

model Role {
  id          String   @id @default(uuid())
  name        UserRole @unique
  description String?

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model User {
  id String @id @default(uuid())

  fullName String

  email String @unique

  passwordHash String

  phone String?

  address String?

  region String?

  emailVerified Boolean @default(false)

  isActive Boolean @default(true)

  lastLogin DateTime?

  roleId String

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  refreshTokens RefreshToken[]

  // E-waste submissions the user owns (as a consumer). See Submission.user.
  submissions Submission[] @relation("SubmissionOwner")

  // Submissions assigned to this user as collector / recycler (future phases).
  collectedSubmissions Submission[] @relation("SubmissionCollector")

  recycledSubmissions Submission[] @relation("SubmissionRecycler")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid())

  // SHA-256 hex digest of the refresh token — the raw token is never stored.
  tokenHash String @unique

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime

  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Submission {
  id String @id @default(uuid())

  userId String

  // Owning consumer. Restrict deletes: submissions are audit records and must
  // not disappear when a user row is removed.
  user User @relation("SubmissionOwner", fields: [userId], references: [id], onDelete: Restrict)

  category String

  description String?

  estimatedWeight Float

  address String

  latitude Float

  longitude Float

  imageUrls String[] @default([])

  status SubmissionStatus @default(PENDING)

  // Assignment targets — nullable, populated in later lifecycle phases.
  assignedCollectorId String?

  assignedCollector User? @relation("SubmissionCollector", fields: [assignedCollectorId], references: [id], onDelete: SetNull)

  assignedRecyclerId String?

  assignedRecycler User? @relation("SubmissionRecycler", fields: [assignedRecyclerId], references: [id], onDelete: SetNull)

  pickupScheduledAt DateTime?

  completedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([assignedCollectorId])
  @@index([assignedRecyclerId])
  @@map("submissions")
}
