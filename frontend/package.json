{
  "name": "ecotrace-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "EcoTrace India React dashboard — web frontend foundation",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
