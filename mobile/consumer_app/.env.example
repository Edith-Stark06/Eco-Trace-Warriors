# Copy to .env.local and fill in <HOST-IP> with the LAN IP of the machine
# running `docker compose up` (backend on :3000, device_ai on :8100).
# localhost does NOT work from a physical phone — see docs/mobile/README.md.
EXPO_PUBLIC_API_BASE_URL=http://<HOST-IP>:3000/api/v1
EXPO_PUBLIC_DEVICE_AI_BASE_URL=http://<HOST-IP>:8100
